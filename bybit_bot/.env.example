# Copy this file to .env and fill in your own values.
# NEVER commit a real .env file with real keys to git.

# Bybit API credentials (create with "Contract Trading" permission only,
# NOT withdrawal permission). Leave blank to stay in DRY_RUN.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# true = Bybit testnet (fake funds, safe to experiment). Change to false
# only when you are ready to trade with real funds on mainnet.
BYBIT_TESTNET=true

# true = the bot computes signals and logs what it WOULD do, but never
# calls any order-placing endpoint. Keep this true until you have
# reviewed live logs for at least a few days on testnet.
DRY_RUN=true

# Comma-separated list of USDT perpetual symbols to scan. The bot only
# trades a symbol when ITS OWN price action matches the strategy in
# bot/strategy.py — listing a symbol here does not force any trade.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,LTCUSDT

# How often (seconds) the bot polls for new closed 15m candles.
POLL_INTERVAL_SECONDS=60

# Safety cap on how many symbols can have an open position at once.
MAX_CONCURRENT_POSITIONS=4

# Only needed if BYBIT_API_KEY is blank (pure dry-run with no exchange
# account) — the bot has no other way to know your simulated equity.
# Leave unset when using a real (even testnet) account; the bot then
# reads real wallet equity from Bybit.
EQUITY_OVERRIDE_USDT=10000

LOG_LEVEL=INFO
